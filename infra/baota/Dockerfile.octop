# 精简 Octop：网页发布用。不含 OCR / 本地向量 / Playwright 浏览器。
#
# 阶段 1：构建 dashboard（React/Vite）。产物落 /build/src/octop/dashboard，
# 由阶段 2 COPY 进镜像的 src/octop/dashboard，Octop 才挂 SPA（/agent/chat）。
# 早期版本漏了这个阶段，产物只能靠本地手搓 dist 再 rsync，--delete 一并删掉后
# 就会重现"后端健康、/agent/chat 404"。现在镜像自包含，不再依赖宿主 dist。
FROM node:20-slim AS frontend-builder

ARG NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
ARG NODE_MAX_OLD_SPACE_SIZE=2048
ARG PNPM_VERSION=10
WORKDIR /build/dashboard

COPY dashboard/package.json dashboard/pnpm-lock.yaml dashboard/.npmrc ./
RUN --mount=type=cache,target=/root/.cache/pnpm,sharing=locked \
    set -eu; \
    npm config set registry "$NPM_REGISTRY"; \
    npm install -g "pnpm@${PNPM_VERSION}" --no-audit --no-fund; \
    pnpm config set registry "$NPM_REGISTRY"; \
    pnpm install --frozen-lockfile \
    || { echo "pnpm install failed — retrying clean"; rm -rf node_modules; pnpm install --frozen-lockfile; }; \
    test -x node_modules/.bin/vite

COPY dashboard/ ./
RUN mkdir -p ../src/octop/dashboard

# 镜像构建跳过完整 tsc；生产打包由 vite/esbuild 完成（使用 lockfile 中的 vite）
RUN NODE_ENV=production NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" pnpm run build:docker

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/data \
    OCTOP_BIND_HOST=0.0.0.0 \
    OCTOP_PORT=8088 \
    OCTOP_LOG_LEVEL=info \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple \
    UV_INSECURE_HOST=mirrors.cloud.tencent.com

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi \
  && apt-get update \
  && apt-get install -y --no-install-recommends curl git ca-certificates gcc make libc6-dev linux-libc-dev \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir uv -i https://mirrors.cloud.tencent.com/pypi/simple

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --no-dev

COPY src/ ./src/
COPY --from=frontend-builder /build/src/octop/dashboard ./src/octop/dashboard
COPY .env.example ./
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
  && uv sync --no-dev \
  && mkdir -p /data/.octop

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8088
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD ["sh", "-c", "curl -f http://localhost:${OCTOP_PORT:-8088}/api/health || exit 1"]
ENTRYPOINT ["docker-entrypoint.sh"]
CMD []
