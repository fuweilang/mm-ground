FROM node:22-bookworm-slim

# 国内构建：Debian 源换腾讯云镜像（与 Dockerfile.octop 保持一致），避免 apt 卡住
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi \
  && apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# npm 也走腾讯云镜像（corepack 下 pnpm 的下载同样走镜像）
ENV COREPACK_NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate \
  && pnpm config set registry https://mirrors.cloud.tencent.com/npm/

WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY apps/backend/package.json apps/backend/
COPY apps/backend/prisma apps/backend/prisma
RUN pnpm install --frozen-lockfile --filter @mammoth/backend...
COPY packages/shared packages/shared
COPY apps/backend apps/backend
RUN pnpm --filter @mammoth/shared build \
  && pnpm --filter @mammoth/backend prisma:generate \
  && pnpm --filter @mammoth/backend build
WORKDIR /app/apps/backend
ENV PORT=3100
EXPOSE 3100
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]